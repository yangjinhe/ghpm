.nh
.TH "GHPM" "1" "Nov 2026" "ghpm" "ghpm manual"

.SH NAME
ghpm-rollback - Switch an app back to a previously installed version


.SH SYNOPSIS
\fBghpm rollback  [version] [flags]\fP


.SH DESCRIPTION
Switch an app back to a previously installed version


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for rollback


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP=""
	config file (default ~/.config/ghpm/config.yaml)

.PP
\fB--json\fP[=false]
	machine readable output (where supported)

.PP
\fB--no-cache\fP[=false]
	bypass the release metadata cache

.PP
\fB--proxy\fP=""
	HTTP(S) proxy URL, overrides config


.SH SEE ALSO
\fBghpm(1)\fP
