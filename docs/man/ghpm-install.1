.nh
.TH "GHPM" "1" "Nov 2026" "ghpm 0.2.0-dev" "ghpm manual"

.SH NAME
ghpm-install - Download and install configured apps


.SH SYNOPSIS
\fBghpm install [id...] [flags]\fP


.SH DESCRIPTION
Installs the named apps. With no arguments only missing apps are installed;
--all installs or upgrades every configured app.


.SH OPTIONS
\fB--all\fP[=false]
	install or upgrade every configured app

.PP
\fB--arch\fP=""
	target architecture (default: this machine)

.PP
\fB--force\fP[=false]
	replace files and symlinks not owned by ghpm

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for install

.PP
\fB--os\fP=""
	target operating system (default: this machine)

.PP
\fB--tag\fP=""
	install a specific tag instead of the configured channel


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP=""
	config file (default ~/.config/ghpm/config.yaml)

.PP
\fB--json\fP[=false]
	machine readable output (where supported)

.PP
\fB--no-cache\fP[=false]
	bypass the release metadata cache

.PP
\fB--proxy\fP=""
	HTTP(S) proxy URL, overrides config


.SH SEE ALSO
\fBghpm(1)\fP
