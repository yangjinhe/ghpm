.nh
.TH "GHPM" "1" "Nov 2026" "ghpm" "ghpm manual"

.SH NAME
ghpm-prune - Delete old installed versions


.SH SYNOPSIS
\fBghpm prune [id...] [flags]\fP


.SH DESCRIPTION
Delete old installed versions


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for prune

.PP
\fB--keep\fP=0
	number of versions to keep (default from config)

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP=""
	config file (default ~/.config/ghpm/config.yaml)

.PP
\fB--json\fP[=false]
	machine readable output (where supported)

.PP
\fB--no-cache\fP[=false]
	bypass the release metadata cache

.PP
\fB--proxy\fP=""
	HTTP(S) proxy URL, overrides config


.SH SEE ALSO
\fBghpm(1)\fP
