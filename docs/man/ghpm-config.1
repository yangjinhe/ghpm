.nh
.TH "GHPM" "1" "Nov 2026" "ghpm" "ghpm manual"

.SH NAME
ghpm-config - Show the configuration file


.SH SYNOPSIS
\fBghpm config [flags]\fP


.SH DESCRIPTION
Show the configuration file


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for config

.PP
\fB--path\fP[=false]
	print only the config file path


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP=""
	config file (default ~/.config/ghpm/config.yaml)

.PP
\fB--json\fP[=false]
	machine readable output (where supported)

.PP
\fB--no-cache\fP[=false]
	bypass the release metadata cache

.PP
\fB--proxy\fP=""
	HTTP(S) proxy URL, overrides config


.SH SEE ALSO
\fBghpm(1)\fP
