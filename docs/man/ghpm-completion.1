.nh
.TH "GHPM" "1" "Nov 2026" "ghpm 0.2.0-dev" "ghpm manual"

.SH NAME
ghpm-completion - Generate the autocompletion script for the specified shell


.SH SYNOPSIS
\fBghpm completion [flags]\fP


.SH DESCRIPTION
Generate the autocompletion script for ghpm for the specified shell.
See each sub-command's help for details on how to use the generated script.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for completion


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP=""
	config file (default ~/.config/ghpm/config.yaml)

.PP
\fB--json\fP[=false]
	machine readable output (where supported)

.PP
\fB--no-cache\fP[=false]
	bypass the release metadata cache

.PP
\fB--proxy\fP=""
	HTTP(S) proxy URL, overrides config


.SH SEE ALSO
\fBghpm(1)\fP, \fBghpm-completion-bash(1)\fP, \fBghpm-completion-fish(1)\fP, \fBghpm-completion-powershell(1)\fP, \fBghpm-completion-zsh(1)\fP
