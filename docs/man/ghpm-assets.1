.nh
.TH "GHPM" "1" "Nov 2026" "ghpm" "ghpm manual"

.SH NAME
ghpm-assets - Show release assets and how ghpm scores them


.SH SYNOPSIS
\fBghpm assets  [flags]\fP


.SH DESCRIPTION
Show release assets and how ghpm scores them


.SH OPTIONS
\fB--arch\fP=""
	target architecture (default: this machine)

.PP
\fB--channel\fP=""
	latest, prerelease or tag:

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for assets

.PP
\fB--os\fP=""
	target operating system (default: this machine)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP=""
	config file (default ~/.config/ghpm/config.yaml)

.PP
\fB--json\fP[=false]
	machine readable output (where supported)

.PP
\fB--no-cache\fP[=false]
	bypass the release metadata cache

.PP
\fB--proxy\fP=""
	HTTP(S) proxy URL, overrides config


.SH SEE ALSO
\fBghpm(1)\fP
